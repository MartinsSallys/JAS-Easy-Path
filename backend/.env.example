# App
APP_NAME="JAS Easy Path API"
DEBUG=false
API_PREFIX="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rotacerta"
DATABASE_ECHO=false

# Geocoding (Nominatim)
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="jas-easy-path/1.0"
NOMINATIM_RATE_LIMIT=1.0

# Matrix (OpenRouteService)
ORS_BASE_URL="https://api.openrouteservice.org"
ORS_API_KEY=""  # Get from https://openrouteservice.org/
ORS_RATE_LIMIT=40
ORS_MAX_LOCATIONS=50

# Optimization (OR-Tools)
ORTOOLS_TIME_LIMIT_SECONDS=30
ORTOOLS_FIRST_SOLUTION_STRATEGY="PATH_CHEAPEST_ARC"

# CORS
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'